---
// The Purpose Quest mark: the phyllotaxis sun (concept A in labs/logo-lab.html).
import { sunPresets, sunSeeds } from '../lib/phyllotaxis';

interface Props {
  class?: string;
  /** `mark` for 28–64 px, `small` below that, `full` for large display. */
  variant?: keyof typeof sunPresets;
  label?: string;
}
const { class: className, variant = 'mark', label } = Astro.props;
const seeds = sunSeeds(sunPresets[variant]);
---

<svg
  class={className}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {seeds.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} fill={s.fill} />)}
</svg>
