---
import { blooms, months, drySeason } from '../data/living-place';

const monthNames = ['November', 'December', 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October'];
// Grid columns are 1-based; a bar from month index a to b spans columns a+1 to b+2.
const cols = (from: number, to: number) => `grid-column:${from + 1} / ${to + 2}`;
---

<figure class="figure">
  <div class="figure__frame">
    <div class="cal">
      <div class="cal__row cal__row--head" aria-hidden="true">
        <span class="cal__name"></span>
        <div class="cal__track cal__track--head">
          <span class="cal__season" style={cols(drySeason.from, drySeason.to)}>Dry season</span>
          {
            months.map((m, i) => (
              <span class="cal__month" style={`grid-column:${i + 1}`}>
                <span class="cal__month-long">{m}</span>
                <span class="cal__month-short">{m.charAt(0)}</span>
              </span>
            ))
          }
        </div>
      </div>
      <ul class="cal__list" role="list">
        {
          blooms.map((b) => (
            <li class="cal__row">
              <div class="cal__name">
                <strong>{b.name}</strong>
                <em>{b.latin}</em>
              </div>
              <div class="cal__track">
                <span class="cal__dry" style={cols(drySeason.from, drySeason.to)} aria-hidden="true" />
                <span class="cal__bar" style={`${cols(b.from, b.to)};background:${b.color}`} aria-hidden="true" />
                <span class="visually-hidden">
                  flowers from {monthNames[b.from]} to {monthNames[b.to]}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption>
    Flowering months from the Costa Rica Tree Atlas and the Área de Conservación Guanacaste, poró from iNaturalist
    flowering records (medium confidence). Cortez amarillo opens all at once, about nine days after a cool day or a
    rain in the dry season, and the flowers last only four to five days.
  </figcaption>
</figure>

<style>
  .cal__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cal__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--hairline);
  }
  .cal__row--head {
    border-bottom-color: var(--hairline-strong);
    padding-block: 0 0.5rem;
  }
  @media (min-width: 720px) {
    .cal__row {
      grid-template-columns: 14rem 1fr;
      gap: 1rem;
      align-items: stretch;
    }
  }
  .cal__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    line-height: 1.3;
  }
  @media (min-width: 720px) {
    .cal__name {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
    }
  }
  .cal__name strong {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .cal__name em {
    font-size: 0.78rem;
    color: var(--ink-subtle);
  }
  .cal__track {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    min-height: 1.3rem;
  }
  .cal__track--head {
    grid-template-rows: auto auto;
    row-gap: 0.25rem;
  }
  .cal__season {
    grid-row: 1;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay);
    border-bottom: 2px solid var(--clay);
    padding-bottom: 0.15rem;
    white-space: nowrap;
  }
  .cal__month {
    grid-row: 2;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
  .cal__month-short {
    display: none;
  }
  @media (max-width: 520px) {
    .cal__month-long {
      display: none;
    }
    .cal__month-short {
      display: inline;
    }
  }
  .cal__dry,
  .cal__bar {
    grid-row: 1;
  }
  .cal__dry {
    align-self: stretch;
    margin-block: -0.35rem;
    background: rgb(226 214 192 / 0.5);
  }
  @media (min-width: 720px) {
    .cal__dry {
      margin-block: -0.6rem;
    }
  }
  .cal__bar {
    position: relative;
    z-index: 1;
    height: 0.95rem;
    margin-inline: 2px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(28 43 33 / 0.16);
  }
</style>
