---
import { localizedPath, type Lang } from '../i18n/config';
import { ui } from '../i18n/ui';
import { explorations } from '../content/site';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer band">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name"><Logo class="site-footer__mark" /><span>The Purpose <em>Quest</em></span></p>
      <p class="muted small">{t.tagline}</p>
    </div>
    <ul class="small">
      <li><a href={localizedPath(lang, '/explorations/')}>{t.nav.explorations}</a></li>
      {
        explorations.map((e) => (
          <li>
            <a href={localizedPath(lang, e.path)}>{e.content[lang].card.title}</a>
          </li>
        ))
      }
    </ul>
    <p class="muted small site-footer__legal">© {year} The Purpose Quest</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    border-top: 1px solid rgb(244 238 226 / 0.12);
  }
  .site-footer__inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  .site-footer__name {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-variation-settings: 'SOFT' 60;
    margin-bottom: 0.4rem;
  }
  .site-footer__name :global(.site-footer__mark) {
    width: 3rem;
    height: 3rem;
    flex: none;
  }
  .site-footer__name em {
    font-style: italic;
    color: var(--bloom);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  a {
    color: var(--on-band);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .site-footer__legal {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(244 238 226 / 0.18);
  }
  @media (min-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr;
    }
    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
