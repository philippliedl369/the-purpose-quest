---
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer band">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">The Purpose <em>Quest</em></p>
      <p class="muted small">Projects and concepts, researched carefully and designed to be beautiful.</p>
    </div>
    <ul class="small">
      <li><a href={url('/projects/')}>Projects</a></li>
      <li><a href={url('/projects/living-place-costa-rica/')}>A Living Place in Costa Rica</a></li>
    </ul>
    <p class="muted small site-footer__legal">© {year} The Purpose Quest</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    border-top: 1px solid rgb(244 238 226 / 0.12);
  }
  .site-footer__inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-variation-settings: 'SOFT' 60;
    margin-bottom: 0.4rem;
  }
  .site-footer__name em {
    font-style: italic;
    color: var(--bloom);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  a {
    color: var(--on-band);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .site-footer__legal {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(244 238 226 / 0.18);
  }
  @media (min-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr;
    }
    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
