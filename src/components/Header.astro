---
import Logo from './Logo.astro';
import { languages, langs, localizedPath, type Lang } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const t = ui[lang];
const inExplorations = path.startsWith('/explorations');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={localizedPath(lang, '/')} aria-label={t.home}>
      <Logo class="wordmark__mark" />
      <span>The Purpose <em>Quest</em></span>
    </a>
    <div class="site-header__nav">
      <nav aria-label={t.navLabel}>
        <ul>
          <li>
            <a href={localizedPath(lang, '/explorations/')} aria-current={inExplorations ? 'page' : undefined}>
              {t.nav.explorations}
            </a>
          </li>
          <li><a href={`${localizedPath(lang, '/')}#approach`}>{t.nav.approach}</a></li>
        </ul>
      </nav>
      <nav aria-label={t.langLabel} class="langs">
        <ul>
          {
            langs.map((l) => (
              <li>
                <a
                  href={localizedPath(l, path)}
                  hreflang={l}
                  lang={l}
                  aria-current={l === lang ? 'true' : undefined}
                  title={languages[l].label}
                >
                  {languages[l].short}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(244 238 226 / 0.86);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--hairline);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 450;
    letter-spacing: -0.01em;
    font-variation-settings: 'SOFT' 60;
    color: var(--forest);
    white-space: nowrap;
  }
  .wordmark em {
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .wordmark :global(.wordmark__mark) {
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2.25rem);
  }
  ul {
    display: flex;
    gap: clamp(0.9rem, 0.5rem + 1.6vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: currentColor;
  }
  .langs ul {
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
  }
  .langs a {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 0;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .langs a[aria-current='true'] {
    background: var(--forest);
    color: var(--on-band);
  }
  .langs a:hover:not([aria-current='true']) {
    color: var(--ink);
    background: var(--surface);
  }
  @media (max-width: 640px) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: 0.25rem;
      padding-block: 0.6rem;
    }
    .site-header__nav {
      width: 100%;
      justify-content: space-between;
    }
    .wordmark {
      font-size: 1.15rem;
    }
  }
</style>
