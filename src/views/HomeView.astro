---
import Base from '../layouts/Base.astro';
import Landscape from '../components/Landscape.astro';
import ExplorationCard from '../components/ExplorationCard.astro';
import { localizedPath, type Lang } from '../i18n/config';
import { ui } from '../i18n/ui';
import { explorations, site } from '../content/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = site[lang];
const u = ui[lang];
const featured = explorations[0];
const f = featured.content[lang];
---

<Base lang={lang} path="/" description={t.meta.description}>
  <section class="hero">
    <div class="container hero__text">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="display" set:html={t.hero.title} />
      <p class="lede">{t.hero.lede}</p>
    </div>
    <div class="hero__art">
      <Landscape />
    </div>
  </section>

  <section class="band featured">
    <div class="container featured__grid">
      <div class="featured__text">
        <p class="eyebrow">{t.featured.eyebrow}</p>
        <h2>{f.card.title}</h2>
        <p class="lede">{f.card.summary}</p>
        <div class="facts">
          {
            f.intro.facts.map((fact) => (
              <div class="fact">
                <div class="fact__value">{fact.value}</div>
                <div class="fact__label">{fact.label}</div>
              </div>
            ))
          }
        </div>
        <a class="btn" href={localizedPath(lang, featured.path)}>{u.readExploration} <span aria-hidden="true">→</span></a>
      </div>
      <div class="featured__art">
        <Landscape variant="dusk" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="explorations-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.list.eyebrow}</p>
        <h2 id="explorations-title">{t.list.title}</h2>
      </div>
      <div class="cards">
        {
          explorations.map((e) => (
            <ExplorationCard
              href={localizedPath(lang, e.path)}
              title={e.content[lang].card.title}
              summary={e.content[lang].card.summary}
              badge={u.exploration}
              place={e.content[lang].card.place}
              readLabel={u.readExploration}
            />
          ))
        }
        <div class="cards__next">
          <p class="small muted">{t.list.more}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band--soft approach" id="approach" aria-labelledby="approach-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.approach.eyebrow}</p>
        <h2 id="approach-title">{t.approach.title}</h2>
      </div>
      <ol class="principles">
        {
          t.approach.items.map((item, i) => (
            <li>
              <span class="principles__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3.5rem, 2rem + 6vw, 7.5rem);
  }
  .hero__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .hero__text .display {
    max-width: 14ch;
    color: var(--forest);
  }
  .hero__text .display :global(em) {
    color: var(--clay);
  }
  .hero__art {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    height: clamp(260px, 38vw, 560px);
    overflow: hidden;
  }
  .hero__art :global(svg) {
    width: 100%;
    height: 100%;
  }

  .featured {
    padding-block: var(--section);
  }
  .featured__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }
  .featured__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .featured__text .facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    width: 100%;
    margin-block: 0.5rem 1rem;
  }
  .featured__art {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(244 238 226 / 0.1);
    aspect-ratio: 4 / 5;
  }
  .featured__art :global(svg) {
    width: 100%;
    height: 100%;
  }
  @media (min-width: 900px) {
    .featured__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  .cards__next {
    display: grid;
    place-items: center;
    min-height: 12rem;
    padding: 2rem;
    border: 1px dashed var(--hairline);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .approach {
    padding-block: var(--section);
  }
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    border-top: 1px solid var(--hairline-strong);
  }
  .principles li {
    padding: 1.75rem 1.75rem 2rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .principles__n {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--clay);
    margin-bottom: 1.25rem;
  }
  .principles h3 {
    margin-bottom: 0.6rem;
  }
  .principles p {
    color: var(--ink-muted);
    margin: 0;
  }
</style>
