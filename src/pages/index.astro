---
import Base from '../layouts/Base.astro';
import Landscape from '../components/Landscape.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { url } from '../lib/url';

const featured = projects[0];
---

<Base>
  <section class="hero">
    <div class="container hero__text">
      <p class="eyebrow">Projects &amp; concepts</p>
      <h1 class="display">Beautiful ideas, <em>on solid ground.</em></h1>
      <p class="lede">
        The Purpose Quest collects the projects and concepts I am working on. Each one starts with careful research,
        aims to be beautiful, and stays honest about what is still open.
      </p>
    </div>
    <div class="hero__art">
      <Landscape />
    </div>
  </section>

  <section class="band featured">
    <div class="container featured__grid">
      <div class="featured__text">
        <p class="eyebrow">Current project</p>
        <h2>{featured.title}</h2>
        <p class="lede">{featured.summary}</p>
        <div class="facts">
          <div class="fact">
            <div class="fact__value">4–8</div>
            <div class="fact__label">core households to start</div>
          </div>
          <div class="fact">
            <div class="fact__value">70–80 %</div>
            <div class="fact__label">self-sufficiency in water, energy and staple foods</div>
          </div>
          <div class="fact">
            <div class="fact__value">Dec–May</div>
            <div class="fact__label">native trees in flower through the dry season</div>
          </div>
        </div>
        <a class="btn" href={url(`/projects/${featured.slug}/`)}>Read the project <span aria-hidden="true">→</span></a>
      </div>
      <div class="featured__art">
        <Landscape variant="dusk" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Projects</p>
        <h2 id="projects-title">What I am working on</h2>
      </div>
      <div class="projects">
        {projects.map((p) => <ProjectCard project={p} />)}
        <div class="projects__next">
          <p class="small muted">More projects and concepts will be added here.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band--soft approach" id="approach" aria-labelledby="approach-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Approach</p>
        <h2 id="approach-title">How the work is done</h2>
      </div>
      <ol class="principles">
        <li>
          <span class="principles__n">01</span>
          <h3>Research before decisions</h3>
          <p>Every figure comes with a source and a confidence rating. Estimates are shown as estimates.</p>
        </li>
        <li>
          <span class="principles__n">02</span>
          <h3>Beauty is a goal</h3>
          <p>The most beautiful elements should also be the most useful ones. Function and delight are designed together.</p>
        </li>
        <li>
          <span class="principles__n">03</span>
          <h3>Open questions stay open</h3>
          <p>What is not known yet is written down as an open question, not filled with something that merely sounds right.</p>
        </li>
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3.5rem, 2rem + 6vw, 7.5rem);
  }
  .hero__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .hero__text .display {
    max-width: 14ch;
    color: var(--forest);
  }
  .hero__text .display em {
    color: var(--clay);
  }
  .hero__art {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    height: clamp(260px, 38vw, 560px);
    overflow: hidden;
  }
  .hero__art :global(svg) {
    width: 100%;
    height: 100%;
  }

  .featured {
    padding-block: var(--section);
  }
  .featured__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }
  .featured__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .featured__text .facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    width: 100%;
    margin-block: 0.5rem 1rem;
  }
  .featured__art {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(244 238 226 / 0.1);
    aspect-ratio: 4 / 5;
  }
  .featured__art :global(svg) {
    width: 100%;
    height: 100%;
  }
  @media (min-width: 900px) {
    .featured__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .projects {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  .projects__next {
    display: grid;
    place-items: center;
    min-height: 12rem;
    padding: 2rem;
    border: 1px dashed var(--hairline);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .approach {
    padding-block: var(--section);
  }
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    border-top: 1px solid var(--hairline-strong);
  }
  .principles li {
    padding: 1.75rem 1.75rem 2rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .principles__n {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--clay);
    margin-bottom: 1.25rem;
  }
  .principles h3 {
    margin-bottom: 0.6rem;
  }
  .principles p {
    color: var(--ink-muted);
    margin: 0;
  }
</style>
