---
import Base from '../../layouts/Base.astro';
import Landscape from '../../components/Landscape.astro';
import RainfallChart from '../../components/RainfallChart.astro';
import ZoneDiagram from '../../components/ZoneDiagram.astro';
import BloomCalendar from '../../components/BloomCalendar.astro';
import StageTimeline from '../../components/StageTimeline.astro';
import { avoid } from '../../data/living-place';

const principles = [
  {
    title: 'Water first',
    text: 'Water is the fundamental question. The region is chosen for water security over decades, and the land is designed as a water cycle: save, harvest, store, let it soak in, reuse grey and black water, create wetlands.',
  },
  {
    title: 'Plan for tomorrow’s climate',
    text: 'The benchmark is the climate of 2040 to 2060, not the average of the past thirty years.',
  },
  {
    title: 'One system, not separate measures',
    text: 'Crops, animals, soil, water and energy interlock. What one part leaves behind, another part lives on.',
  },
  {
    title: 'Beauty and function together',
    text: 'Flowering useful trees, water as mirror and habitat, paths that invite a walk: the most beautiful elements should also be useful.',
  },
];

const animals = [
  {
    when: 'Year 1',
    title: 'Worms and black soldier fly larvae',
    text: 'They turn kitchen and garden waste into compost and protein, and they need almost no water. Larvae meal is about 40 % protein.',
  },
  {
    when: 'Year 1–2',
    title: 'A small flock of chickens',
    text: 'Fifteen to thirty hens lay eggs from early on. Their feed is another matter: a hen eats about 130 g a day, and foraging covers only a small part of it.',
  },
  {
    when: 'Year 1–2',
    title: 'Stingless bees',
    text: 'Native mariola bees pollinate and fascinate. Up to five colonies are allowed without selling honey, registered with the national conservation agency. Each gives 1–2 kg of honey a year.',
  },
  {
    when: 'Year 2',
    title: 'Oyster mushrooms',
    text: 'Grown on harvest leftovers in a cool room or in the rainy season. Above about 36 °C green mould takes over.',
  },
  {
    when: 'Year 3 +',
    title: 'Pigs on deep litter, optional',
    text: 'They turn bedding into compost and save water compared with washed pens, but even a single pig needs a veterinary operating certificate.',
  },
];
---

<Base
  title="A Living Place in Costa Rica"
  description="A small community in Costa Rica where soil, water, plants, animals and people work together, and the dry season becomes the flowering season."
>
  <section class="hero">
    <div class="container hero__text">
      <p class="eyebrow">Project · Research phase</p>
      <h1 class="display">A Living Place in <em>Costa Rica</em></h1>
      <p class="lede">
        A small community where soil, water, plants, animals and people work together: regenerative, circular,
        space-efficient and beautiful.
      </p>
    </div>
    <div class="hero__art">
      <Landscape />
    </div>
  </section>

  <section class="section" aria-labelledby="idea">
    <div class="container idea">
      <div class="section-head">
        <p class="eyebrow">The idea</p>
        <h2 id="idea">Beauty is the goal, <em>not a by-product.</em></h2>
      </div>
      <div class="prose">
        <p>
          On Costa Rica’s fertile, life-affirming soil, something fascinating should grow: a place that largely feeds
          itself and is a joy to live in. Private homes, shared infrastructure, and time to build it up step by step.
        </p>
      </div>
      <div class="facts">
        <div class="fact">
          <div class="fact__value">4–8</div>
          <div class="fact__label">core households to start, each with a private home</div>
        </div>
        <div class="fact">
          <div class="fact__value">70–80 %</div>
          <div class="fact__label">self-sufficiency in water, energy and staple foods, plus outside income</div>
        </div>
        <div class="fact">
          <div class="fact__value">Years</div>
          <div class="fact__label">built up step by step, with no pressure to buy</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="principles">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Guiding principles</p>
        <h2 id="principles">Four ideas that shape every decision</h2>
      </div>
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li>
              <span class="principles__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band section climate" aria-labelledby="climate">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Two climate worlds</p>
        <h2 id="climate">Where the water is, <em>and where it will be.</em></h2>
        <p class="lede">
          Costa Rica packs very different climates into a small country. On the dry Pacific coast, water is the limit.
          Inland, water is plentiful and the work shifts to fighting fungi and weeds. The region is still open.
        </p>
      </div>
      <div class="climate__grid">
        <RainfallChart />
        <div class="climate__compare">
          <div>
            <h3>Dry Pacific</h3>
            <p>
              Around Sámara it rains about as much in a year as on the Atlantic slopes of Turrialba, but only about 4 %
              of it falls between December and March. Clay-rich soils, fertile but hard and cracked in the dry season.
              The main task is to store and save water.
            </p>
          </div>
          <div>
            <h3>Humid inland</h3>
            <p>
              Little or no dry season. Acidic, leached soils, fungal diseases, more weeding and pruning. The bottleneck
              moves from water to work.
            </p>
          </div>
          <blockquote class="climate__question">
            <p>This year has been very dry, and water shortages are expected in the next dry season. Will the coast still work for a project like this in the coming decades?</p>
            <footer>The key open question</footer>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="mosaic">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Design</p>
        <h2 id="mosaic">A garden <em>ordered by water</em></h2>
        <p class="lede">
          No single growing method carries a whole place through a long dry season. The land is zoned by how much
          dry-season water each part needs, from a small irrigated core to forest that needs none.
        </p>
      </div>
      <ZoneDiagram />
    </div>
  </section>

  <section class="section band--soft bloom" aria-labelledby="bloom">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Beauty</p>
        <h2 id="bloom">The dry season becomes <em>the flowering season</em></h2>
        <p class="lede">
          Native useful trees flower from December to May, exactly when the dry forest stands bare. Madero negro, the
          backbone of the system, is living fence, mulch and fodder at once, and turns pink in the dry months.
        </p>
      </div>
      <BloomCalendar />
    </div>
  </section>

  <section class="section" aria-labelledby="animals">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Animals</p>
        <h2 id="animals">Animals, <em>in the right order</em></h2>
        <p class="lede">
          The order follows three questions: how much water an animal needs, how high the legal hurdle is, and how
          much it closes the cycle.
        </p>
      </div>
      <ol class="animals">
        {
          animals.map((a) => (
            <li>
              <span class="animals__when">{a.when}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="wild">
        <h3>Wild neighbours</h3>
        <ul class="wild__list">
          <li><strong class="num">114</strong> bat species live in Costa Rica. They pollinate, spread seeds and eat insects.</li>
          <li><strong class="num">14</strong> hummingbird species have been recorded on the Nicoya Peninsula.</li>
          <li><strong>Morpho</strong> butterflies are seen there all year, even in the dry season.</li>
          <li><strong>Fireflies</strong> peak in May, when the rains return.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section band--soft" aria-labelledby="avoid">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we avoid</p>
        <h2 id="avoid">Beautiful, <em>but not here</em></h2>
        <p class="lede">
          Several favourite permaculture and garden plants are listed as invasive in Costa Rica, and some are toxic.
          Where the research names a native alternative, it is given.
        </p>
      </div>
      <ul class="avoid">
        {
          avoid.map((a) => (
            <li>
              <span class="avoid__why">{a.why}</span>
              <h3>{a.name}</h3>
              <p class="avoid__latin">{a.latin}</p>
              {a.instead && (
                <p class="avoid__instead">
                  <span>Instead</span> {a.instead}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="stages">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Timeline</p>
        <h2 id="stages">Self-sufficiency <em>grows in stages</em></h2>
        <p class="lede">
          Vegetables come first, fruit follows, staple foods take longest. The real bottleneck is working time: roughly
          one full-time person plus shared work days. <span class="estimate">Estimate</span>
        </p>
      </div>
      <StageTimeline />
    </div>
  </section>

  <section class="band section" aria-labelledby="open">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Open questions</p>
        <h2 id="open">What we <em>don’t know yet</em></h2>
      </div>
      <ol class="next">
        <li>
          <h3>Coast or inland?</h3>
          <p>How will water on the coast develop up to about 2060, compared with the humid inland regions?</p>
        </li>
        <li>
          <h3>How do we close the water cycle?</h3>
          <p>Saving, rainwater harvesting, reusing grey and black water, and constructed wetlands that clean water and bring life.</p>
        </li>
        <li>
          <h3>What must a site offer?</h3>
          <p>Water over decades, open land that may legally be farmed, a clean title, low natural hazards, and a place that feels right.</p>
        </li>
        <li>
          <h3>Then: region, site, decision</h3>
          <p>Choose a region, search for land, check it on the ground through a full dry season, and only then decide.</p>
        </li>
      </ol>
      <p class="source sources-note">
        About the figures: they come from research carried out in September 2026, drawing on Costa Rica’s national
        weather service (IMN), FAO, CATIE, INTA, the University of Costa Rica, SINAC and others. Statements the
        research rates as low confidence are marked as estimates.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3.5rem, 2rem + 6vw, 7.5rem);
  }
  .hero__text {
    display: grid;
    gap: 1.5rem;
  }
  .hero__text .display {
    max-width: 12ch;
    color: var(--forest);
  }
  .hero__text .display em {
    color: var(--clay);
  }
  .hero__art {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    height: clamp(260px, 38vw, 560px);
    overflow: hidden;
  }
  .hero__art :global(svg) {
    width: 100%;
    height: 100%;
  }
  h2 em {
    color: var(--clay);
  }
  .band h2 em,
  .climate h2 em {
    color: var(--bloom);
  }

  .idea .prose {
    margin-bottom: 2.5rem;
  }
  .idea .prose p {
    font-size: var(--text-lede);
    line-height: 1.55;
  }

  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 3rem;
    border-top: 1px solid var(--hairline-strong);
  }
  @media (min-width: 800px) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }
  .principles li {
    padding: 1.75rem 2rem 2.25rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .principles__n {
    display: block;
    font-family: var(--font-display);
    color: var(--clay);
    margin-bottom: 1rem;
  }
  .principles h3 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
    margin-bottom: 0.6rem;
  }
  .principles p {
    color: var(--ink-muted);
    margin: 0;
    max-width: 34rem;
  }

  .climate__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }
  @media (min-width: 1000px) {
    .climate__grid {
      grid-template-columns: 1.35fr 1fr;
      align-items: start;
    }
  }
  .climate__compare {
    display: grid;
    gap: 1.75rem;
  }
  .climate__compare h3 {
    margin-bottom: 0.4rem;
  }
  .climate__compare p {
    color: var(--on-band-muted);
    margin: 0;
  }
  .climate__question {
    margin: 0.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--bloom);
  }
  .climate__question p {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
    line-height: 1.3;
    color: var(--on-band);
    font-variation-settings: 'SOFT' 80;
  }
  .climate__question footer {
    margin-top: 0.75rem;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bloom);
  }

  .animals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
    gap: 1rem;
    counter-reset: step;
  }
  .animals li {
    position: relative;
    padding: 1.5rem;
    background: var(--surface);
    border-radius: var(--radius-lg);
  }
  .animals__when {
    display: inline-block;
    margin-bottom: 0.9rem;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--leaf);
  }
  .animals h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }
  .animals p {
    font-size: var(--text-small);
    color: var(--ink-muted);
    margin: 0;
  }
  .wild {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--hairline-strong);
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .wild {
      grid-template-columns: 14rem 1fr;
    }
  }
  .wild__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    color: var(--ink-muted);
  }
  .wild__list strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 450;
    font-size: 1.15rem;
  }

  .avoid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }
  .avoid li {
    padding: 1.4rem 1.5rem 1.5rem;
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
  }
  .avoid__why {
    display: inline-block;
    margin-bottom: 0.8rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .avoid h3 {
    font-size: 1.3rem;
  }
  .avoid__latin {
    margin: 0.2rem 0 0;
    font-style: italic;
    font-size: var(--text-small);
    color: var(--ink-subtle);
  }
  .avoid__instead {
    margin: 0.9rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--hairline);
    font-size: var(--text-small);
    color: var(--ink-muted);
  }
  .avoid__instead span {
    font-weight: 600;
    color: var(--leaf);
    margin-right: 0.25rem;
  }

  .next {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    border-top: 1px solid var(--on-band);
    counter-reset: q;
  }
  .next li {
    counter-increment: q;
    padding: 1.5rem 1.75rem 2rem 0;
    border-bottom: 1px solid rgb(244 238 226 / 0.18);
  }
  .next li::before {
    content: counter(q, decimal-leading-zero);
    display: block;
    font-family: var(--font-display);
    color: var(--bloom);
    margin-bottom: 1rem;
  }
  .next h3 {
    margin-bottom: 0.5rem;
  }
  .next p {
    color: var(--on-band-muted);
    margin: 0;
    font-size: var(--text-small);
  }
  .sources-note {
    margin-top: 3rem;
  }
</style>
