---
import Base from '../layouts/Base.astro';
import { localizedPath } from '../i18n/config';
---

<Base lang="en" path="/404/" title="Page not found">
  <section class="section">
    <div class="container section-head">
      <p class="eyebrow">404</p>
      <h1>This path leads <em>nowhere yet.</em></h1>
      <p class="lede">The page does not exist, or it has moved.</p>
      <p><a class="btn" href={localizedPath('en', '/')}>Back to the start</a></p>
    </div>
  </section>
</Base>
